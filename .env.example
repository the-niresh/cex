# Copy to `.env`. Compose reads it; it is not committed.

# api signs tokens with this and ws verifies them, so the two must match
# exactly or every private WebSocket subscription is refused while the rest of
# the stack looks healthy. Generate one with: openssl rand -hex 32
CEX_JWT_SECRET=

# Managed Postgres in a deployment. For local development, start the bundled
# one with `docker compose --profile local-db up -d` and use:
#   postgres://cex:cex@postgres:5432/cex
CEX_DATABASE_URL=

# Comma-separated, listed explicitly and never `*` — a wildcard would hand a
# token-bearing API to any page on the internet.
CEX_CORS_ORIGINS=https://cex.niresh.tech
